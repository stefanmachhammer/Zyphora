---
/**
 * Installer router — 302s to the right step based on current install state,
 * so a bookmarked `/install` always lands the operator on the correct step.
 */
import { getInstallState } from '../../lib/install.ts';

const state = await getInstallState();

if (state === 'no-db-config') return Astro.redirect('/install/database');
if (state === 'no-tables' || state === 'no-admin') return Astro.redirect('/install/site');

// `'installed'` normally 404s in middleware; guard here too in case that relaxes.
return Astro.redirect('/admin');
---
